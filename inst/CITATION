# ftfy for R is a port of ftfy by Robyn Speer. Her citation comes first, in
# her wording and with her version, as given in the README of python-ftfy
# v6.3.1 (ADR 0012). Do not update the version or the year: they are those of
# the Zenodo record she asks to be cited.

citHeader(
  "ftfy for R is a port of ftfy by Robyn Speer.",
  "If you use it in research, please cite ftfy:"
)

bibentry(
  bibtype = "Misc",
  key = "speer-2019-ftfy",
  author = person("Robyn", "Speer"),
  title = "ftfy",
  note = "Version 5.5",
  year = "2019",
  howpublished = "Zenodo",
  doi = "10.5281/zenodo.2591652",
  url = "https://doi.org/10.5281/zenodo.2591652",
  textVersion = "Robyn Speer. (2019). ftfy (Version 5.5). Zenodo. http://doi.org/10.5281/zenodo.2591652"
)

# The R package. `meta` is the package's DESCRIPTION; it has no Date field,
# so the year is that of the build when there is one.
local({
  date <- c(meta$Date, meta$`Date/Publication`, sub(";.*$", "", meta$Packaged), format(Sys.Date()))
  year <- substr(date[!is.na(date) & nzchar(date)][1L], 1L, 4L)
  bibentry(
    bibtype = "Manual",
    key = "ftfy-r",
    header = "To name the R port as well, add:",
    author = c(person("Robyn", "Speer"), person("Edward", "Barker")),
    title = paste0("{ftfy}: ", meta$Title),
    year = year,
    note = paste0("R package version ", meta$Version, ". A port of Python ftfy ", meta$`Config/ftfy/upstream`),
    url = "https://github.com/epabarker/r-ftfy"
  )
})
